{
	"name": "haifisch-bot",
	"version": "1.0.0",
	"description": "",
	"license": "ISC",
	"main": "build/src/index.js",
	"scripts": {
		"start": "npm run build && node --env-file=.env build/src/index.js",
		"pm2:start": "npm run build && sudo pm2 start ./ecosystem.config.js",
		"pm2:stop": "pm2 stop 'all' && pm2 kill && pm2 flush",
		"pm2": "pm2 stop 'all' && pm2 kill && pm2 flush && npm run build && sudo pm2 start ./ecosystem.config.js",
		"dev": "npx tsx ./src/index.ts",
		"build": "rm -rf ./build && tsc --project tsconfig.build.json",
		"prepare": "npm run build",
		"clear-logs": "rm -rf ./logs",
		"generate": "npx ts-node ./scripts/generate-types-from-swagger.ts"
	},
	"dependencies": {
		"axios": "^1.7.9",
		"body-parser": "1.20.3",
		"express": "4.21.2",
		"p-limit": "6.2.0",
		"telegraf": "4.16.3",
		"winston": "3.17.0"
	},
	"devDependencies": {
		"@types/body-parser": "1.19.5",
		"@types/express": "5.0.0",
		"@types/node": "22.13.4",
		"@typescript-eslint/eslint-plugin": "8.24.1",
		"@typescript-eslint/parser": "8.24.1",
		"dayjs": "1.11.13",
		"eslint": "9.20.1",
		"eslint-plugin-import": "2.31.0",
		"eslint-plugin-promise": "7.2.1",
		"swagger-typescript-api": "13.0.22",
		"typescript": "5.7.3"
	}
}
