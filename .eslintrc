{
	"env": {
		"browser": true,
		"es2021": true
	},
	"extends": "standard-with-typescript",
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module",
		"project": "./tsconfig.json"
	},
	"rules": {
		"indent": "off",
		"@typescript-eslint/indent": "off",
		"no-tabs": "off",
		"@typescript-eslint/no-tabs": "off",
		"comma-dangle": "off",
		"@typescript-eslint/comma-dangle": "off"
	}
}
